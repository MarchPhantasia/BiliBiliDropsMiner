{
  "manifest_version": 3,
  "name": "Bilibili Drops Miner Cookie Bridge",
  "description": "Import the current Chrome profile's Bilibili login cookie into Bilibili Drops Miner.",
  "version": "1.0.0",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.bilibili.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "同步 Bilibili Cookie",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
